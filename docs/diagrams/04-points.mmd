flowchart TB
    classDef entry fill:#F1F5F9,stroke:#64748B,color:#24364C;
    classDef orchestrator fill:#EAF2FF,stroke:#3575C5,color:#24364C;
    classDef agent fill:#E9F6F1,stroke:#288366,color:#24364C;
    classDef tool fill:#EFF8EC,stroke:#66933B,color:#24364C;
    classDef storage fill:#F2EDFC,stroke:#8867B4,color:#24364C;
    classDef model fill:#F4EEFF,stroke:#8C60BD,color:#24364C;
    classDef decision fill:#FFF4DE,stroke:#BD8833,color:#24364C;
    classDef error fill:#FFF0EE,stroke:#CA6B5A,color:#24364C;
    classDef planned fill:#F5F5F5,stroke:#87909D,color:#24364C,stroke-dasharray:5 3;
    classDef external fill:#FFF1E5,stroke:#BB7D42,color:#24364C;
    points_understand["points_understand<br/>模型理解动作与参数"]:::orchestrator
    points_query["query / catalog / recommend<br/>余额与纪念品图文目录"]:::tool
    points_orders["orders / order_status<br/>订单与物流状态"]:::tool
    redeem["redeem<br/>核对候选 / 积分 / 库存"]:::decision
    reward_selection["reward_selection<br/>近似名称候选由用户选择"]:::decision
    shipping["收货地址查询与选择<br/>缺失时先创建地址"]:::tool
    address_preview["address_add / update<br/>地址预览与独立确认"]:::decision
    save_shipping_address["save_shipping_address<br/>成功后续接兑换预览"]:::tool
    order_preview["awaiting_redemption_confirmation<br/>纪念品 / 积分 / 收货信息"]:::decision
    redeem_reward["redeem_reward<br/>最终确认才请求下单"]:::tool
    order_actions["取消订单 / 修改收货信息<br/>默认地址等操作单独确认"]:::decision
    points_reply["points_reply<br/>模型依据工具事实回复"]:::model
    points_handoff["points_handoff<br/>保留待办或完成回交"]:::orchestrator
    points_understand -->|"只读"| points_query
    points_understand -->|"只读"| points_orders
    points_understand -->|"兑换意向"| redeem
    redeem -->|"名称需澄清"| reward_selection
    reward_selection -->|"明确选中"| shipping
    redeem -->|"礼品已明确且足够"| shipping
    shipping -->|"没有可用地址"| address_preview
    address_preview -->|"确认保存"| save_shipping_address
    save_shipping_address -->|"保存回执成功"| order_preview
    shipping -->|"已明确选择已有地址"| order_preview
    order_preview -->|"最终确认兑换"| redeem_reward
    redeem_reward -->|"下单回执决定结果"| points_reply
    points_query --> points_reply
    points_orders --> points_reply
    points_understand --> order_actions
    order_actions -->|"确认后接口回执"| points_reply
    points_reply --> points_handoff
