    temporary_retriever -->|"人工检查"| confirm_evaluation
    confirm_evaluation --> publish
    publish --> default_retriever
    BGEEncoder --> vector_store
    default_retriever --> HybridRetriever
    default_retriever -->|"启用向量后端时"| BGEEncoder
    vector_store --> HybridRetriever
    HybridRetriever -->|"启用精排时"| BGEReranker
    HybridRetriever -->|"未启用精排"| knowledge_evidence
    BGEReranker --> knowledge_evidence
