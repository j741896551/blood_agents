# 主模型服务：变量名沿用 OpenAI 兼容接口约定，也可填写 DeepSeek 等兼容服务。
# Key 留空时不启用主服务；使用非 OpenAI 服务时必须同时填写其 BASE_URL 和 MODEL。
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=40
# 每进程主模型最大在途数；未知供应商额度时保持 1，实测后逐级增大。
LLM_MAX_CONCURRENCY=1

# 备用服务独立配置；Key 留空则不启用。主备均留空仍使用规则模式。
BACKUP_OPENAI_API_KEY=
BACKUP_OPENAI_BASE_URL=
BACKUP_OPENAI_MODEL=gpt-4o-mini
BACKUP_LLM_TIMEOUT_SECONDS=20
BACKUP_LLM_MAX_CONCURRENCY=1

# 主备共用的故障切换设置
LLM_TOTAL_TIMEOUT_SECONDS=60
LLM_FAILURE_THRESHOLD=2
LLM_CIRCUIT_COOLDOWN_SECONDS=30
BLOOD_AGENT_DB=./blood_agent.db
# 默认通过 HTTP 调用外部业务服务；本地开发可启动被 Git 忽略的 local_business 服务。
# mcp 模式仅将礼品、积分、献血记录只读查询转经 stdio MCP；其余查询和写操作仍经 HTTP。
# local 仅供本地插件测试，发布 Agent 代码时不要启用。
BLOOD_AGENT_BUSINESS_TRANSPORT=http
# BLOOD_AGENT_LEGACY_API_URL=http://127.0.0.1:8001
# BLOOD_AGENT_LEGACY_API_TIMEOUT=10
# 本地替身业务库仅由 local_business 服务使用，与 Agent 的会话库分开。
# BLOOD_AGENT_LOCAL_BUSINESS_DB=./local_business.db
# Agent 文件会话库默认另建 ./blood_agent.checkpoints.db 持久化 LangGraph 状态；可改为独立路径。
# checkpoint 可能包含未脱敏的流程资料，只用于合成数据本地演示，不等于对话表。
# BLOOD_AGENT_CHECKPOINT_DB=./blood_agent.checkpoints.db
# 对话表保留天数；0 表示不自动删除。设为正整数后，每次保存新轮次时删除更早的对话表行。
# 清理 conversation_turns 及已无轮次的会话标题/摘要；不清理外部业务库、checkpoint 或 JSONL 追踪。
BLOOD_AGENT_CONVERSATION_RETENTION_DAYS=0
# 兼容旧配置：stdio 会把礼品/积分/献血记录查询转到 MCP，同样依赖上述 HTTP 服务。
# 推荐改用 BLOOD_AGENT_BUSINESS_TRANSPORT=mcp；MCP 不暴露写操作。
BLOOD_AGENT_MCP_REWARDS=

# 默认不增加内容风控模型调用；设为 model 可开启违法有害/辱骂/歧视等内容审查。
# 内容模型审查有额外延迟与费用，不保证法律合规；关键业务回执与隐私保护不受此开关影响。
BLOOD_AGENT_RISK_MODE=passthrough

# 本地演示默认 full：记录原话、模型完整输入/输出及纠正前后槽位；summary 只记录流程，off 关闭。
# full 日志可能包含个人信息，仅用于本地调试；文件权限为 0600，logs/ 不会被 Git 跟踪。
BLOOD_AGENT_TRACE_MODE=full
BLOOD_AGENT_TRACE_FILE=./logs/blood-agent-trace.jsonl

# 主服务可选示例：DeepSeek
# OPENAI_API_KEY=<在 DeepSeek 平台创建的 API Key>
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-flash

# RAG 可选演示组件
VECTOR_BACKEND=memory
# 可选 faiss 或 milvus；仅显式启用时才加载约 1.3 GB 的 BGE 模型。
# 余弦阈值来自本地少量正反例，只是演示初值，不能作为通用可信度保证。
RAG_DENSE_MIN_SCORE=0.55
# Milvus Lite 用本地 .db；不要使用 MILVUS_URI（会与 pymilvus 自身环境变量冲突）。
# 语料或模型变化时会新建带指纹的 collection，不删除旧索引。
RAG_MILVUS_URI=./data/blood_knowledge.db
MILVUS_COLLECTION=blood_knowledge
# 可选远端 Milvus 的鉴权；本地 Lite 留空。
# MILVUS_TOKEN=
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# 精排默认关闭；设为 bge 才会加载 CrossEncoder。精排只排序，不决定有无证据。
RAG_RERANKER=none
RERANKER_MODEL=BAAI/bge-reranker-base

# Gradio
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7861
GRADIO_ANALYTICS_ENABLED=False
